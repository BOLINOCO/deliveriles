[TEMPLATE]
# ============================================================
# Dupliquez ce fichier en .env.local puis renseignez vos clés.
# L'app tourne SANS ces variables (mode démo, données mock) —
# chaque bloc branché s'active dès que ses variables existent.
# ============================================================

# Clé API Anthropic — nécessaire pour l'assistant IA (/api/ai)
# Créez une clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — auth + base + realtime. Dès que ces deux variables
# NEXT_PUBLIC_ sont définies, l'app bascule en mode connecté :
# commandes, courses, stocks, suivi temps réel, auth par mot de passe.
# Récupérables ici : https://supabase.com/dashboard/project/_/settings/api
# Exécutez aussi les migrations SQL (voir README, section Supabase) :
#   supabase/migrations/0001_init.sql
#   supabase/migrations/0002_business_logic.sql
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé service_role — SERVEUR UNIQUEMENT, JAMAIS préfixée NEXT_PUBLIC_
# (webhook Stripe : écriture des abonnements en contournant la RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe — abonnements Vendeur (25€/mois) et Livreur Premium (10€/mois)
# 1. Créez les deux Prices récurrents dans le Dashboard Stripe.
# 2. Ajoutez un endpoint webhook pointant sur https://votre-domaine/api/stripe/webhook
#    avec les événements : checkout.session.completed,
#    customer.subscription.updated, customer.subscription.deleted.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_VENDEUR=price_...
STRIPE_PRICE_ID_LIVREUR_PREMIUM=price_...
